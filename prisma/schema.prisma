generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

enum Role {
  PIMPINAN
  ADMIN
  DOSEN
}

model User {
  id        String   @id @default(cuid())
  name      String   @unique
  email     String?  @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}