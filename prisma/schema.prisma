generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

/* =====================================
   ENUM SECTION
===================================== */

enum Role {
  PIMPINAN
  ADMIN
  DOSEN
}

enum PostType {
  AGENDA
  ARTIKEL
  BERITA
  PENGUMUMAN
  WEBINAR
}

enum JenisPrototype {
  ALAT
  APLIKASI
  ALGORITMA
  MODUL
  PSEUDOCODE
  METODE
}

enum JenisBuku {
  BUKU_AJAR
  REFERENSI
}

enum KategoriArtikel {
  OJS
  SINTA
  INTERNASIONAL
  WOS
  SCOPUS
}

enum StatusPenelitian {
  REVIEW
  ACC_PROPOSAL
  REVIEW_LAPORAN_KEMAJUAN_60
  ACC_LAPORAN_KEMAJUAN_60
  REVIEW_LAPORAN_KEMAJUAN_100
  REVIEW_LAPORAN_AKHIR
  SELESAI
  DITOLAK
}

enum LuaranPenelitian {
  SEMINAR_INTERNASIONAL_SCOPUS_ATLANTIS_WOS
  ARTIKEL_JURNAL_NASIONAL_SINTA_5
  ARTIKEL_JURNAL_NASIONAL_SINTA_4
  ARTIKEL_JURNAL_NASIONAL_SINTA_3
  ARTIKEL_JURNAL_NASIONAL_SINTA_2
  PUBLIKASI_JURNAL_INTERNATIONAL_BEREPUTASI_SCOPUS_WOS
  PUBLIKASI_JURNAL_INTERNATIONAL_SCOPUS_Q4_WOS
  PUBLIKASI_JURNAL_INTERNATIONAL_SCOPUS_Q3_WOS
  PUBLIKASI_JURNAL_INTERNATIONAL_SCOPUS_Q2_WOS
  PUBLIKASI_JURNAL_INTERNATIONAL_SCOPUS_Q1_WOS
  HKI_PATEN
  BUKU_ISBN
  PROTOTYPE
}

enum KategoriPenelitian {
  PENELITIAN_DOSEN_PEMULA
  PENELITIAN_TERAPAN
  PENELITIAN_PENGEMBANGAN
  PENELITIAN_UNGGULAN_PERGURUAN_TINGGI
  PENELITIAN_GURU_BESAR_PERCEPATAN_PROFESOR
  PENELITIAN_BEKERJASAMA_MITRA_NASIONAL
  PENELITIAN_BEKERJASAMA_MITRA_INTERNASIONAL
}

enum RoleDosenPenelitian {
  KETUA
  ANGGOTA
}

enum ProgramStudiDosenPenelitian {
  D3_MANAJEMEN_INFORMATIKA
  S1_SISTEM_INFORMASI
  S1_SISTEM_KOMPUTER
  S1_TEKNIK_INFORMATIKA
  S1_MANAJEMEN
  S1_AKUNTANSI
  S1_TEKNIK_SIPIL
  S1_TEKNIK_INDUSTRI
  S1_PSIKOLOGI
  S1_DESAIN_KOMUNIKASI_VISUAL
  S1_PTIK
  S1_BIMBINGAN_KONSELING
  S1_BAHASA_INGGRIS
  S2_TEKNIK_INFORMATIKA
  S2_MANAJEMEN
  S3_TEKNOLOGI_INFORMASI
}

enum StatusPengabdian {
  REVIEW
  ACC_PROPOSAL
  REVIEW_LAPORAN_KEMAJUAN_60
  ACC_LAPORAN_KEMAJUAN_60
  REVIEW_LAPORAN_KEMAJUAN_100
  REVIEW_LAPORAN_AKHIR
  SELESAI 
  DITOLAK
}

enum LuaranPengabdian {
  SEMINAR_INTERNASIONAL_SCOPUS_ATLANTIS_WOS
  ARTIKEL_JURNAL_NASIONAL_SINTA_5
  ARTIKEL_JURNAL_NASIONAL_SINTA_4
  ARTIKEL_JURNAL_NASIONAL_SINTA_3
  ARTIKEL_JURNAL_NASIONAL_SINTA_2
  PUBLIKASI_JURNAL_INTERNATIONAL_BEREPUTASI_SCOPUS_WOS
  PUBLIKASI_JURNAL_INTERNATIONAL_SCOPUS_Q4_WOS
  PUBLIKASI_JURNAL_INTERNATIONAL_SCOPUS_Q3_WOS
  PUBLIKASI_JURNAL_INTERNATIONAL_SCOPUS_Q2_WOS
  PUBLIKASI_JURNAL_INTERNATIONAL_SCOPUS_Q1_WOS
  HKI_PATEN
  BUKU_ISBN
  PROTOTYPE
}

enum KategoriPengabdian {
  PENGABDIAN_MASYARAKAT
  PENGABDIAN_DOSEN_PEMULA
  PENGABDIAN_TERAPAN
  PENGABDIAN_ILMU
  PENGABDIAN_PENGEMBANGAN
  PENGABDIAN_UNGGULAN_PERGURUAN_TINGGI
  PENGABDIAN_GURU_BESAR_PERCEPATAN_PROFESOR
  PENGABDIAN_BEKERJASAMA_MITRA_NASIONAL
  PENGABDIAN_BEKERJASAMA_MITRA_INTERNASIONAL
}

enum RoleDosenPengabdian {
  KETUA
  ANGGOTA
}

/* =====================================
   MODEL SECTION
===================================== */

/* ---------- USER ---------- */
model User {
  id        String   @id
  name      String   @unique
  email     String?  @unique
  nohp      String?  @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi konten dan luaran
  posts         Post[]
  prototypes    Prototype[]
  buku          Buku[]
  prestasi      Prestasi[]
  artikel       Artikel[]
  artikel1      Artikel1[]
  hki           HKI[]
  pkm           PKM[]
  penelitian    Penelitian[]
  dosenPenelitian dosenPenelitian[]
  pengabdian    Pengabdian[]
  dosenPengabdian dosenPengabdian[]

  // Relasi untuk review & approval
  penelitianReviewed  Penelitian[] @relation("PenelitianReviewer")
  penelitianApproved  Penelitian[] @relation("PenelitianApprover")
  pengabdianReviewed  Pengabdian[] @relation("PengabdianReviewer")
  pengabdianApproved  Pengabdian[] @relation("PengabdianApprover")
}

/* ---------- POST ---------- */
model Post {
  id          String   @id @default(cuid())
  type        PostType
  title       String
  content     String
  thumbnail   String?
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([createdAt])
}

/* ---------- PROTOTYPE ---------- */
model Prototype {
  id              String   @id @default(cuid())
  author          String[]
  namaPrototype   String
  fungsiPrototype String
  penggunaUtama   String
  jenisPrototype  String[]
  link            String
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/* ---------- BUKU ---------- */
model Buku {
  id          String   @id
  author      String[]
  judulBuku   String
  penerbit    String
  isbn        String
  tahun       Int
  jenisBuku   JenisBuku
  linkBuku    String
  pkmId       String?
  pkm         PKM?     @relation(fields: [pkmId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/* ---------- HKI ---------- */
model HKI {
  id                String   @id
  author            String[]
  nomorPenciptaan   String
  tanggalPermohonan DateTime
  jenisCiptaan      String
  judulCiptaan      String
  linkSertifikat    String
  pkmId             String?
  pkm               PKM?     @relation(fields: [pkmId], references: [id], onDelete: Cascade)
  createdById       String
  createdBy         User     @relation(fields: [createdById], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/* ---------- ARTIKEL ---------- */
model Artikel {
  id               String   @id
  author           String[]
  judul            String
  namaArtikel      String
  publisher        String
  kategori         KategoriArtikel
  level            String?
  linkArtikel      String
  tanggalPublisher DateTime?
  pkmId            String?
  pkm              PKM?     @relation(fields: [pkmId], references: [id], onDelete: Cascade)
  createdById      String
  createdBy        User     @relation(fields: [createdById], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/* ---------- PKM ---------- */
model PKM {
  id                  String   @id
  judul               String
  proposal            String
  laporan             String
  tanggalPelaksanaan  DateTime?
  artikel             Artikel[]
  hki                 HKI[]
  buku                Buku[]
  createdById         String
  createdBy           User     @relation(fields: [createdById], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/* ---------- PRESTASI ---------- */
model Prestasi {
  id              String   @id @default(cuid())
  namaPrestasi    String
  jenisPretasi    String
  peringkatJuara  String
  tingkat         String
  tanggal         DateTime
  penyelenggara   String
  linkSertifikat  String
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/* ---------- PENELITIAN ---------- */
model Penelitian {
  id                  String   @id @default(cuid())
  judulPenelitian     String
  kategoriPenelitian  KategoriPenelitian
  lamaKegiatan        String
  tahunKegiatan       Int
  anggaran            Int?
  sumberAnggaran      String?
  luaran              LuaranPenelitian[]
  statusPenelitian    StatusPenelitian @default(REVIEW)
  
  // Review & Approval
  reviewedById        String?
  reviewedBy          User?    @relation("PenelitianReviewer", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?
  reviewNotes         String?
  approvedById        String?
  approvedBy          User?    @relation("PenelitianApprover", fields: [approvedById], references: [id])
  approvedAt          DateTime?
  approvalNotes       String?

  // Dosen & Luaran
  dosenPenelitian     dosenPenelitian[]
  linkProposal        String
  linkLaporanKemajuan String?
  statusLuaran        String?
  linkLaporanAkhir    String?
  linkLuaran          String?

  createdById         String
  createdBy           User     @relation(fields: [createdById], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/* ---------- DOSEN PENELITIAN ---------- */
model dosenPenelitian {
  id                           String   @id
  dosenId                      String
  dosen                        User     @relation(fields: [dosenId], references: [id])
  namaDosen                    String
  NIDN                         String
  noHp                         String?
  roleDosenPenelitian          RoleDosenPenelitian
  programStudiDosenPenelitian  ProgramStudiDosenPenelitian
  penelitianId                 String
  penelitian                   Penelitian @relation(fields: [penelitianId], references: [id])
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

/* ---------- PENGABDIAN ---------- */
model Pengabdian {
  id                  String   @id @default(cuid())
  judulPengabdian     String
  kategoriPengabdian  KategoriPengabdian
  lamaKegiatan        String
  tahunKegiatan       Int
  anggaran            Int?
  sumberAnggaran      String?
  luaran              LuaranPengabdian[]
  statusPengabdian    StatusPengabdian @default(REVIEW)
  
  // Review & Approval
  reviewedById        String?
  reviewedBy          User?    @relation("PengabdianReviewer", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?
  reviewNotes         String?
  approvedById        String?
  approvedBy          User?    @relation("PengabdianApprover", fields: [approvedById], references: [id])
  approvedAt          DateTime?
  approvalNotes       String?

  // Dosen & Luaran
  dosenPengabdian     dosenPengabdian[]
  linkProposal        String
  linkLaporanKemajuan String?
  statusLuaran        String?
  linkLaporanAkhir    String?
  linkLuaran          String?

  createdById         String
  createdBy           User     @relation(fields: [createdById], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/* ---------- DOSEN PENGABDIAN ---------- */
model dosenPengabdian {
  id                           String   @id
  dosenId                      String
  dosen                        User     @relation(fields: [dosenId], references: [id])
  namaDosen                    String
  NIDN                         String
  noHp                         String?
  roleDosenPengabdian          RoleDosenPengabdian
  programStudiDosenPengabdian  ProgramStudiDosenPenelitian
  pengabdianId                 String
  pengabdian                   Pengabdian @relation(fields: [pengabdianId], references: [id])
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

// ---------- Artikel ----------
model Artikel1 {
  id              String   @id @default(cuid())
  judul           String
  author          String[]
  namaArtikel     String
  publisher       String
  kategori        KategoriArtikel
  level           String
  linkArtikel     String
  tanggalPublisher DateTime
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}