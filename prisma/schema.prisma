generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

enum Role {
  PIMPINAN
  ADMIN
  DOSEN
}

// Model User
model User {
  id        String   @id
  name      String   @unique
  email     String?  @unique
  nohp      String?  @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts       Post[]
  publikasi   Publikasi[]
  prototypes  Prototype[]
  buku        Buku[]
  hki         HKI[]
  prestasi    Prestasi[]
  pkm         PKM[]
}

enum PostType {
  AGENDA
  ARTIKEL
  BERITA
  PENGUMUMAN
  WEBINAR
}

// Model Post
model Post {
  id        String   @id @default(cuid()) // ID unik konten
  type      PostType // Jenis konten: Agenda, Artikel, Berita, Pengumuman, Webinar
  title     String   // Judul konten
  content   String   // Isi utama konten (HTML atau Markdown)
  thumbnail String?  // Gambar utama / cover konten (opsional)

  // Khusus untuk tipe Agenda & Webinar
  location  String?    // Lokasi acara (opsional)
  startDate DateTime?  // Tanggal mulai acara (opsional)
  endDate   DateTime?  // Tanggal selesai acara (opsional)

  authorId  String   // ID penulis konten
  author    User     @relation(fields: [authorId], references: [id]) // Relasi ke tabel User

  createdAt DateTime @default(now())   // Waktu pembuatan konten
  updatedAt DateTime @updatedAt        // Waktu terakhir update konten

  @@index([type])      // Index untuk mempercepat query berdasarkan tipe konten
  @@index([createdAt]) // Index untuk mempercepat query berdasarkan tanggal dibuat
}

enum KategoriJurnal {
  OJS
  SINTA
  INTERNASIONAL
  WOS
  SCOPUS
}


model Publikasi {
  id              String          @id
  author          String[]
  judul           String
  namaJurnal      String
  publisher       String

  kategori        KategoriJurnal  // contoh: "SINTA" atau "SCOPUS"
  level           String?         // contoh: "1" untuk Sinta 1, "Q1" untuk Scopus Q1

  pkmId           String?
  pkm             PKM?            @relation(fields: [pkmId], references: [id])

  createdById     String
  createdBy       User            @relation(fields: [createdById], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([pkmId])
}

enum JenisPrototype {
  ALAT
  APLIKASI
  ALGORITMA
  MODUL
  PSEUDOCODE
  METODE
}

// Model Prototype
model Prototype {
    id                String   @id @default(cuid())

    author            String[]
    namaPrototype     String
    fungsiPrototype   String
    penggunaUtama     String
    jenisPrototype    String[]
    link              String

    createdById     String
    createdBy       User     @relation(fields: [createdById], references: [id])

    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt
}

enum JenisBuku {
  BUKU_AJAR
  REFERENSI
}

// Model Buku
model Buku {
    id                String   @id

    author            String[]
    judulBuku         String
    penerbit          String
    isbn              String
    tahun             Int
    jenisBuku         JenisBuku
    linkBuku          String

  pkmId     String?
  pkm       PKM?     @relation(fields: [pkmId], references: [id])


    createdById     String
    createdBy       User     @relation(fields: [createdById], references: [id])

    createdAt         DateTime @default(now())
    updatedAt         DateTime @updatedAt

    @@unique([pkmId])
}

// Model HKI
model HKI {
  id                String   @id

  author            String[]
  nomorPenciptaan   String
  tanggalPermohonan DateTime
  jenisCiptaan      String
  judulCiptaan      String
  linkSertifikat    String

  pkmId     String?
  pkm       PKM?     @relation(fields: [pkmId], references: [id])


  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([pkmId])
}

// Model PKM
model PKM {
  id          String   @id
  proposal    String   // wajib
  laporan     String   // wajib

  // Relasi luaran (opsional)
  publikasi Publikasi?
  hki       HKI?
  buku      Buku?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Model Prestasi
model Prestasi {
  id                String   @id @default(cuid())

  namaPrestasi      String
  jenisPretasi      String
  peringkatJuara    String
  tingkat           String
  tanggal           DateTime
  penyelenggara     String
  linkSertifikat    String

  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
